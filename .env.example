# Host port the site is served on (nginx in the frontend container proxies /api, /ws, /uploads)
GRIDIRON_PORT=8470
# JWT signing key - generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Web push VAPID private key: put the PEM in data/vapid_private.pem (preferred), or set VAPID_PRIVATE_KEY.
# The public key is hardcoded in frontend/src/lib/notifications.js and must match.
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# Contact sent to push services; Apple requires a real mailto: or https: URL
# VAPID_SUBJECT=https://gridironscore.com
